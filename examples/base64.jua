fn base64chr(i) {
    if 0 <= i && i < 26  return chr(65 + i);
    if 26 <= i && i < 52 return chr(97 + i - 26);
    if 52 <= i && i < 62 return chr(48 + i - 52);
    if i == 62           return '+';
    if i == 63           return '/';
    panic("invalid value: " + i);
}

fn base64ord(c) {
    if 65 <= c && c <= 90  return c - 65;      // A-Z
    if 97 <= c && c <= 122 return c - 97 + 26; // a-z
    if 48 <= c && c <= 57  return c - 48 + 52; // 0-9
    if c == 43             return 62;          // '+'
    if c == 47             return 63;          // '/'
    panic("invalid value: " + c);
}

fn base64encode(str) {
    // Алгоритм делит строку на части по 6 бит,
    // и взаимно-однозначно заменяет их на символы в алфавите мощностью 2^6.
    // В одном байте 8 бит. Удобно обрабатывать данные по 3 байта за итерацию,
    // так как число бит кратно 6: 8*3 = 6*4
    bytes := strToByteArray(str);
    result := "";

    n := length(bytes) / 3;
    for i := 0; i < n; i++ {
        x1 := bytes[i * 3 + 0];
        x2 := bytes[i * 3 + 1];
        x3 := bytes[i * 3 + 2];

        y1 := x1 >> 2;
        y2 := (x1 & 0x3) << 4 | x2 >> 4;
        y3 := (x2 & 0xf) << 2 | x3 >> 6;
        y4 := x3 & 0x3f;

        result += base64chr(y1);
        result += base64chr(y2);
        result += base64chr(y3);
        result += base64chr(y4);
    }

    // Выравнивание
    if length(bytes) - n * 3 == 1 {
        y1 := bytes[n * 3] >> 2;
        y2 := (bytes[n * 3] & 0x3) << 4;
        result += base64chr(y1);
        result += base64chr(y2);
        result += "==";
    } else if length(bytes) - n * 3 == 2 {
        y1 := bytes[n * 3] >> 2;
        y2 := (bytes[n * 3] & 0x3) << 4 | bytes[n * 3 + 1] >> 4;
        y3 := (bytes[n * 3 + 1] & 0xf) << 2;
        result += base64chr(y1);
        result += base64chr(y2);
        result += base64chr(y3);
        result += "=";
    }

    return result;
}

fn base64decode(str) {
    if length(str) % 4 != 0 {
        panic("Invalid base64 string length");
    }

    codepoints := strToCodePointArray(str);
    n := length(codepoints) - 4;

    result := list(length(str));
    p := 0;

    for i := 0; i < n; i += 4 {
        x1 := base64ord(codepoints[i + 0]);
        x2 := base64ord(codepoints[i + 1]);
        x3 := base64ord(codepoints[i + 2]);
        x4 := base64ord(codepoints[i + 3]);

        result[p++] = x1 << 2 | x2 >> 4;
        result[p++] = (x2 & 0xf) << 4 | x3 >> 2;
        result[p++] = (x3 & 0x3) << 6 | x4;
    }

    // Учёт выравнивателей
    x1 := base64ord(codepoints[n + 0]);
    x2 := base64ord(codepoints[n + 1]);
    result[p++] = x1 << 2 | x2 >> 4;
    if codepoints[n + 2] != 61 {
        x3 := base64ord(codepoints[n + 2]);
        result[p++] = (x2 & 0x0F) << 4 | x3 >> 2;
        if codepoints[n + 3] != 61 {
            x4 := base64ord(codepoints[n + 3]);
            result[p++] = (x3 & 0x3) << 6 | x4;
        }
    }

    return byteArrayToStr(result, 0, p);
}
