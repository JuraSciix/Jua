// Рекуррентный алгоритм для вычисления чисел Бернулли.

/* Алгоритм генерации треугольника Паскаля. */
fn _PascalTriangle(height) {
    var cols = list(height);
    for (i := 0; i < height; i++) {
        cols[i] = list(i + 1);
        cols[i][0] = cols[i][i] = 1;
        for (j := 1; j < i; j++) {
            cols[i][j] = cols[i - 1][j - 1] + cols[i - 1][j];
        }
    }
    return cols;
}

fn GetBernoulliNumbers(n) {
    if n < 0 {
        panic("n cannot be less than 0");
    }

    T := _PascalTriangle(n + 2);
    B := list(n + 1);
    B[0] = 1.0;

    for t := 1; t <= n; t++ {
        if t > 1 && (t & 1) == 1 {
            B[t] = 0.0;
            continue;
        }
        S := 1.0;
        for k := 1; k < t; k++ {
            S += T[t + 1][k] * B[k];
        }
        B[t] = -S / (t + 1);
    }
    return B;
}


Bn := GetBernoulliNumbers(50);
for i := 0; i < length(Bn); i++ {
    println(Bn[i]);
}